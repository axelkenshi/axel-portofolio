---
import SearchBar from './SearchBar.svelte';
import { getCollection } from 'astro:content';

interface Props {
  active?: 'home' | 'archive' | 'about' | 'portfolio' | 'knowledge';
}

const { active = 'home' } = Astro.props;

// 📑 1. AMBIL DATA UNTUK SEARCH INDEX (BUILD-TIME)
// Catatan: Ganti 'quil-notes' dengan nama folder koleksi markdown Anda jika berbeda
const notesCollection = await getCollection('notes').catch(() => []);

const searchIndex = notesCollection.map((note) => ({
  id: note.id,
  title: note.data.title || 'Untitled',
  description: note.data.description || '',
  category: note.data.category || 'General',
  tags: note.data.tags || [],
}));

// Navigasi data terpusat lengkap dengan path ikon SVG heroic-style
const navLinks = [
  { name: 'Home', href: '/quil-notes', id: 'home', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { name: 'Archive', href: '/quil-notes/archive', id: 'archive', icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' },
  { name: 'About Writter\'s', href: '/quil-notes/about', id: 'about', icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z' },
  { name: 'Knowledge Notes', href: '/quil-notes/categories/knowledge', id: 'knowledge', icon: 'm12.99 6.74 1.93 3.44M19.136 12a10 10 0 0 1-14.271 0M21 21l-2.16-3.84M3 21l8.02-14.26M14 5a2 2 0 1 1-4 0 2 2 0 0 1 4 0z' },
  { name: 'Portofolio', href: '/dev', id: 'hero-section', icon: 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
];
---

<nav class="w-full max-w-7xl mx-auto bg-quilCard/90 backdrop-blur-md border border-quil-border/60 rounded-xl h-16 flex items-center justify-between px-6 shadow-xl relative z-50">
  
  <a href="/quil-notes" class="flex items-center gap-2 group transition-all active:scale-95">
    <svg class="w-4 h-4 text-quilAccent animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" />
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" />
    </svg>
    <span class="text-quilAccent font-extrabold tracking-tight text-lg group-hover:text-quilText group-active:text-quilText transition-colors">
      Xnshi Note's
    </span>
  </a>

  <div class="hidden lg:flex items-center lg:space-x-6 xl:space-x-8">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class={`text-sm font-medium transition-all duration-200 hover:text-quilText active:text-quilText relative py-1
          ${active === link.id ? 'text-quilAccent font-semibold' : 'text-quil-fg-soft'}`}
      >
        {link.name}
        {active === link.id && (
          <span class="absolute bottom-0 left-0 w-full h-[2px] bg-quilAccent rounded-full" />
        )}
      </a>
    ))}
    <a 
      href="https://github.com/axelkenshi/axel-portofolio" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="text-sm font-medium text-quil-fg-soft hover:text-quilText active:text-quilText flex items-center gap-1 transition-colors group"
    >
      GitHub SC
      <svg class="w-3 h-3 opacity-60 group-hover:opacity-100 group-active:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
    </a>
  </div>

  <div class="flex items-center gap-4 relative">
    
    <button 
      onclick="window.openQuilSearch?.()"
      class="relative hidden lg:flex items-center bg-quil-surface/80 border border-quil-border text-xs text-quil-fg-muted pl-8 pr-4 py-2 rounded-lg w-42 text-left hover:border-quil-border-strong active:border-quil-border-strong cursor-pointer transition-all active:scale-[0.98]"
    >
      <svg class="w-3.5 h-3.5 text-quil-fg-muted absolute left-2.5 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
      <span>Search...</span>
      <span class="absolute right-2 px-1.5 py-0.5 bg-quil-well text-[9px] rounded border border-quil-border font-mono">/</span>
    </button>

    <button
      type="button"
      data-theme-toggle
      aria-label="Ganti tema terang/gelap"
      class="hidden lg:flex items-center justify-center p-2 bg-quil-surface hover:bg-quilAccentMuted active:bg-quilAccentMuted border border-quil-border rounded-lg text-quil-fg-soft hover:text-quilAccent active:text-quilAccent transition-all cursor-pointer active:scale-95"
    >
      <svg class="w-4 h-4 hidden quil-dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
      </svg>
      <svg class="w-4 h-4 quil-dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/>
      </svg>
    </button>
    
    <button 
      id="paletteBtn"
      class="p-2 bg-quil-surface hover:bg-quilAccentMuted active:bg-quilAccentMuted border border-quil-border rounded-lg text-quil-fg-soft hover:text-quilAccent active:text-quilAccent transition-all cursor-pointer active:scale-95"
      aria-label="Ubah Warna Aksen"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" /></svg>
    </button>

    <button 
      id="mobileMenuToggleBtn"
      class="lg:hidden flex flex-col items-center justify-center gap-1 group cursor-pointer focus:outline-none"
      aria-expanded="false"
    >
      <div class="w-9 h-9 rounded-full border border-quil-border group-hover:border-quil-border-strong group-active:border-quil-border-strong bg-quil-surface/40 flex items-center justify-center relative overflow-hidden transition-colors">
        <svg id="hamburgerMenuIcon" class="w-4 h-4 text-quil-fg-soft group-hover:text-quilText group-active:text-quilText transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="closeMenuIcon" class="w-4 h-4 text-quil-fg-soft group-hover:text-quilText group-active:text-quilText absolute opacity-0 scale-75 transition-all duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </div>
    </button>

    <div 
      id="paletteDropdown"
      class="absolute right-0 top-16 bg-quilCard border border-quil-border/80 rounded-xl p-4 shadow-2xl w-64 space-y-3 transform scale-95 opacity-0 pointer-events-none transition-all duration-200 z-50"
    >
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-1.5 text-xs font-semibold text-quil-fg-soft">
          <span class="w-1.5 h-3 bg-quilAccent rounded-full"></span>
          Theme Color
        </div>
        <div class="flex items-center gap-2">
          <button id="resetHue" class="p-1 hover:bg-quil-border active:bg-quil-border text-quil-fg-muted hover:text-quil-fg-soft active:text-quil-fg-soft rounded transition-colors cursor-pointer" title="Reset">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 8H17" /></svg>
          </button>
          <span id="hueValDisplay" class="text-[10px] font-mono px-1.5 py-0.5 bg-quilAccentMuted text-quilText rounded border border-quilAccent/20">174</span>
        </div>
      </div>
      <input type="range" id="hueSlider" min="0" max="360" value="174" class="w-full h-2 rounded-lg appearance-none cursor-pointer border border-quil-border/50 accent-quilAccent" style="background: linear-gradient(to right, #ff0000, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff, #ff0000);"/>
    </div>

    <div 
      id="mobileMenuDropdownPanel"
      class="absolute right-0 top-16 bg-quil-well/95 backdrop-blur-md border border-quil-border rounded-2xl p-2.5 shadow-2xl w-64 flex flex-col space-y-1 transform scale-95 opacity-0 pointer-events-none transition-all duration-200 z-50 lg:hidden"
    >
      {navLinks.map((link) => (
        <a 
          href={link.href}
          class={`flex items-center justify-between px-3 py-2.5 rounded-xl border border-transparent transition-all group/item
            ${active === link.id ? 'bg-quilAccentMuted/20 border-quilAccent/20 text-quilText' : 'hover:bg-quil-surface/60 active:bg-quil-surface/60 text-quil-fg-soft hover:text-quil-fg active:text-quil-fg'}`}
        >
          <div class="flex items-center gap-3">
            <svg class={`w-4 h-4 transition-colors ${active === link.id ? 'text-quilAccent' : 'text-quil-fg-muted group-hover/item:text-quilAccent group-active/item:text-quilAccent'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={link.icon} />
            </svg>
            <span class="text-xs font-semibold tracking-wide">{link.name}</span>
          </div>
          <svg class="w-3.5 h-3.5 text-quil-fg-faint group-hover/item:text-quil-fg-soft group-hover/item:translate-x-0.5 group-active/item:text-quil-fg-soft group-active/item:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      ))}

      <div class="border-t border-quil-border/80 my-1 mx-2"></div>

      <a 
        href="https://github.com/axelkenshi/axel-portofolio" 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center justify-between px-3 py-2.5 rounded-xl text-quil-fg-soft hover:text-quil-fg hover:bg-quil-surface/60 active:text-quil-fg active:bg-quil-surface/60 transition-all group/item"
      >
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 text-quil-fg-muted group-hover/item:text-quilAccent group-active/item:text-quilAccent transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
          <span class="text-xs font-semibold tracking-wide">Repo Project?</span>
        </div>
        <svg class="w-3.5 h-3.5 text-quil-fg-faint group-hover/item:text-quil-fg-soft group-active/item:text-quil-fg-soft transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>

      <div class="border-t border-quil-border/80 my-1 mx-2"></div>

      <button
        type="button"
        data-theme-toggle
        class="lg:hidden flex items-center gap-2 w-full px-3 py-2.5 rounded-xl bg-quilAccent/5 border border-quilAccent/20 text-xs font-semibold text-quil-fg-soft hover:border-quilAccent/40 active:scale-[0.98] transition-all"
      >
        <svg class="w-3.5 h-3.5 shrink-0 hidden quil-dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
        </svg>
        <svg class="w-3.5 h-3.5 shrink-0 quil-dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/>
        </svg>
        <span class="hidden quil-dark:inline">Switch to light</span>
        <span class="quil-dark:hidden">Switch to dark</span>
      </button>
      
      <button
        type="button"
        id="mobileSearchBtn"
        class="flex items-center gap-2 w-full px-3 py-2.5 rounded-xl bg-quil-surface/80 border border-quil-border text-xs text-quil-fg-muted hover:border-quil-border-strong active:border-quil-border-strong transition-all active:scale-[0.98]"
      >
        <svg class="w-3.5 h-3.5 text-quil-fg-muted shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span>Search...</span>
      </button>
    </div>

  </div>
</nav>

{/* 🛠️ 2. PENYUNTIKAN KOMPONEN SVELTE DENGAN STRATEGI HIDRASI AKTIF */}
<SearchBar client:idle searchIndex={searchIndex} />

<script>
  // --- INISIALISASI ELEMEN ---
  const paletteBtn = document.getElementById('paletteBtn');
  const paletteDropdown = document.getElementById('paletteDropdown');
  const hueSlider = document.getElementById('hueSlider') as HTMLInputElement;
  const hueValDisplay = document.getElementById('hueValDisplay');
  const resetHue = document.getElementById('resetHue');

  const mobileMenuToggleBtn = document.getElementById('mobileMenuToggleBtn');
  const mobileMenuDropdownPanel = document.getElementById('mobileMenuDropdownPanel');
  const hamburgerMenuIcon = document.getElementById('hamburgerMenuIcon');
  const closeMenuIcon = document.getElementById('closeMenuIcon');

  const mobileSearchBtn = document.getElementById('mobileSearchBtn');

  // --- LOGIKA LIGHT/DARK MODE TOGGLE
  function setQuilTheme(isDark: boolean) {
    document.documentElement.classList.toggle('quil-dark', isDark);
    document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
    try {
      localStorage.setItem('quil-theme', isDark ? 'dark' : 'light');
    } catch {}
  }
  
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation(); // menu mobile tetap terbuka
      setQuilTheme(!document.documentElement.classList.contains('quil-dark'));
    });
  });
  
  // --- LOGIKA TOGGLE MENU UTAMA MOBILE ---
  mobileMenuToggleBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    paletteDropdown?.classList.add('scale-95', 'opacity-0', 'pointer-events-none'); 

    const isExpanded = mobileMenuToggleBtn.getAttribute('aria-expanded') === 'true';
    if (isExpanded) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  });

  function openMobileMenu() {
    mobileMenuToggleBtn?.setAttribute('aria-expanded', 'true');
    mobileMenuDropdownPanel?.classList.remove('scale-95', 'opacity-0', 'pointer-events-none');
    hamburgerMenuIcon?.classList.add('opacity-0', 'scale-75');
    closeMenuIcon?.classList.remove('opacity-0', 'scale-75');
  }

  function closeMobileMenu() {
    mobileMenuToggleBtn?.setAttribute('aria-expanded', 'false');
    mobileMenuDropdownPanel?.classList.add('scale-95', 'opacity-0', 'pointer-events-none');
    hamburgerMenuIcon?.classList.remove('opacity-0', 'scale-75');
    closeMenuIcon?.classList.add('opacity-0', 'scale-75');
  }

  // --- Handler searchbar (masih logika MENU UTAMA TOGGLE MOBILE) ---
  mobileSearchBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeMobileMenu();
    (window as Window & { openQuilSearch?: () => void }).openQuilSearch?.();
  });
  
  // --- INTERAKSI PALETTE HUE SLIDER ---
  paletteBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeMobileMenu(); 
    paletteDropdown?.classList.toggle('scale-95');
    paletteDropdown?.classList.toggle('opacity-0');
    paletteDropdown?.classList.toggle('pointer-events-none');
  });

  document.addEventListener('click', () => {
    paletteDropdown?.classList.add('scale-95', 'opacity-0', 'pointer-events-none');
    closeMobileMenu();
  });
  
  paletteDropdown?.addEventListener('click', (e) => e.stopPropagation());
  mobileMenuDropdownPanel?.addEventListener('click', (e) => e.stopPropagation());

  // Sinkronisasi status Hue CSS variabel dengan LocalStorage
  const initialHue = localStorage.getItem('quil-theme-hue') || '174';
  if (hueSlider && hueValDisplay) {
    hueSlider.value = initialHue;
    hueValDisplay.textContent = initialHue;
  }

  hueSlider?.addEventListener('input', (e) => {
    const value = (e.target as HTMLInputElement).value;
    if (hueValDisplay) hueValDisplay.textContent = value;
    document.documentElement.style.setProperty('--theme-hue', value);
    localStorage.setItem('quil-theme-hue', value);
  });

  resetHue?.addEventListener('click', () => {
    if (hueSlider && hueValDisplay) {
      hueSlider.value = '174';
      hueValDisplay.textContent = '174';
      document.documentElement.style.setProperty('--theme-hue', '174');
      localStorage.setItem('quil-theme-hue', '174');
    }
  });
</script>
