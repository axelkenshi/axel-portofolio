---
// src/components/AboutMe.astro

// Satu sumber data untuk ribbon techstack (dirender dua kali agar loop mulus)
const techLogos = [
  { src: "/img/techstack/html.svg", alt: "HTML5" },        // lang img
  { src: "/img/techstack/css.svg", alt: "CSS3" },
  { src: "/img/techstack/js.svg", alt: "JavaScript" },
  { src: "/img/techstack/ts.svg", alt: "TypeScript" },
  { src: "/img/techstack/php.svg", alt: "php" },
  { src: "/img/techstack/mysql.svg", alt: "mysql" },
  { src: "/img/techstack/tailwind.svg", alt: "Tailwind" },
  { src: "/img/techstack/bootstrap.svg", alt: "bootstrap" },
  { src: "/img/techstack/astro.svg", alt: "Astro", invertDark: true },
  { src: "/img/techstack/svelte.svg", alt: "Svelte" },
  { src: "/img/techstack/nodejs.svg", alt: "NodeJS" },
  { src: "/img/techstack/vite-tool.svg", alt: "vite" },        // tools img
  { src: "/img/techstack/firebase-tool.svg", alt: "firebase" },
  { src: "/img/techstack/zed-tool.svg", alt: "zed" },
  { src: "/img/techstack/gemini-tool.svg", alt: "gemini" },
  { src: "/img/techstack/claude-tool.svg", alt: "claude" },
];

// Kelas dasar setiap logo. invertDark hanya untuk logo yang perlu dibalik warnanya di dark mode
const logoClass = (invertDark = false) =>
  `h-8 w-auto opacity-75 grayscale hover:grayscale-0 dark:hover:opacity-100 transition duration-300${invertDark ? ' dark:invert dark:hover:invert-0' : ''}`;

// Teks notifikasi translasi (satu sumber, diulang di marquee)
const translateNotice = "If you would like to read this in Indonesian or another language, please use the built-in translation feature in your browser's settings.";

// Pengulangan teks di dalam setiap set agar lebar set cukup untuk loop mulus
const noticeRepeat = [0, 1];
---

<section id="about" class="relative snap-start min-h-[100dvh] flex flex-col justify-between overflow-hidden bg-tan dark:bg-dark text-dark dark:text-tan transition-colors duration-300">
  
  <!-- 1. BACKGROUND CANVAS (Pipeline Animation) -->
  <canvas id="pipeline-canvas" class="absolute inset-0 w-full h-full pointer-events-none opacity-25 dark:opacity-35 z-0"></canvas>
  
  <!-- Overlay Gradient Halus (Dinamis Berdasarkan Tema) -->
  <div class="absolute inset-0 bg-linear-to-t from-tan via-transparent to-tan/50 dark:from-dark dark:via-transparent dark:to-dark/50 z-10 pointer-events-none"></div>

  <!-- Spacer Atas agar Konten Utama Tetap Center -->
  <div class="flex-grow flex items-center justify-center">
    
    <!-- 2. KONTEN UTAMA (Foto di Atas Teks untuk Mobile, Berdampingan di Desktop) -->
    <div class="relative z-20 max-w-5xl w-full px-6 py-19 grid md:grid-cols-12 gap-8 md:gap-12 items-center">
      
      <!-- KOLOM FOTO (Urutan Pertama di Mobile, Pindah ke Kanan di Desktop) -->
      <div class="md:col-span-5 flex justify-center md:order-2">
        <div class="relative group">
          <!-- Efek Glow di Belakang Foto -->
          <div class="absolute -inset-1 rounded-2xl bg-linear-to-r from-cyan-500 to-purple-600 opacity-20 dark:opacity-30 blur-xl group-hover:opacity-50 transition duration-500"></div>
          
          <!-- Frame Utama Foto (tanpa backdrop-blur agar tidak menghitung ulang blur di atas canvas) -->
          <div class="relative p-2 bg-white/80 dark:bg-zinc-900/90 border border-zinc-200 dark:border-zinc-800 rounded-2xl">
            <img 
              src="/assets/my.webp" 
              alt="Axel Kenshi Profile Picture" 
              class="rounded-xl object-cover bg-zinc-100 dark:bg-zinc-800" 
              width="280" 
              height="280" 
              decoding="async"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>

      <!-- KOLOM TEKS (Urutan Kedua di Mobile, Pindah ke Kiri di Desktop) -->
      <div class="md:col-span-7 flex flex-col justify-center md:order-1 space-y-6">
        <div>
          <span class="font-mark-script text-2xl text-cyan-600 dark:text-cyan-400 tracking-wide block mb-2">About Me</span>
          <h2 class="text-3xl sm:text-5xl font-black tracking-tight bg-linear-to-r from-zinc-900 via-zinc-700 to-zinc-500 dark:from-white dark:via-zinc-200 dark:to-zinc-400 bg-clip-text text-transparent">
            Crafting Clean Code & Aesthetic Interfaces.
          </h2>
        </div>

        <div class="space-y-4 text-zinc-600 dark:text-zinc-400 leading-relaxed text-sm sm:text-base">
          <p>
            Hi! I'm Axel, a front-end developer who focused on building full-scale web and mobile applications. I'm passionate about the intersection of efficient code architecture and the aesthetic visual details of user interfaces.
          </p>
          <p>
            Through a modern approach using tools such as <span class="text-zinc-800 dark:text-zinc-200 font-semibold">Astro</span> and <span class="text-zinc-800 dark:text-zinc-200 font-semibold">Svelte</span>, I dedicate my time to designing digital systems that are not only high-performing, but also meaningful to their users.
          </p>
        </div>

        <!-- Quick Info / Core Pillars Grid -->
        <div class="grid grid-cols-2 gap-4 pt-4 border-t border-zinc-200 dark:border-zinc-800">
          <div class="flex items-start gap-2">
            <span class="text-cyan-600 dark:text-cyan-400 mt-1">✦</span>
            <div>
              <h4 class="text-sm font-semibold text-zinc-800 dark:text-zinc-200">Clean Architecture</h4>
              <p class="text-xs text-zinc-500 dark:text-zinc-500">Building a clean and scalable system..</p>
            </div>
          </div>
          <div class="flex items-start gap-2">
            <span class="text-purple-600 dark:text-purple-400 mt-1">✦</span>
            <div>
              <h4 class="text-sm font-semibold text-zinc-800 dark:text-zinc-200">Aesthetic UI Design</h4>
              <p class="text-xs text-zinc-500 dark:text-zinc-500">Careful attention to layout and detail.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- 3a. Running text: info translasi browser -->
  <div class="mt-4 overflow-hidden">
    <div class="flex w-max items-center animate-marquee-text whitespace-nowrap text-xs sm:text-sm italic tracking-wide text-zinc-800 dark:text-zinc-200">
      
      <!-- Set Pertama -->
      <div class="flex shrink-0">
        {noticeRepeat.map(() => (
          <>
            <span class="shrink-0 pr-20">{translateNotice}</span>
            <span class="shrink-0 pr-20">|</span>
          </>
        ))}
      </div>

      <!-- Set Kedua (duplikat untuk loop mulus, disembunyikan dari pembaca layar) -->
      <div class="flex shrink-0" aria-hidden="true">
        {noticeRepeat.map(() => (
          <>
            <span class="shrink-0 pr-20">{translateNotice}</span>
            <span class="shrink-0 pr-20">|</span>
          </>
        ))}
      </div>

    </div>
  </div>
  
  <!-- 3b. TECHSTACK RUNNING TEXT (Menggunakan SVG Lokal dari public/img/techstack/) -->
  <div class="relative z-20 w-full bg-tan dark:bg-zinc-900/80 border-t border-zinc-200/60 dark:border-zinc-800/60 py-5 overflow-hidden select-none">
    <!-- Efek Fade Blur di Sisi Kiri & Kanan Slider -->
    <div class="absolute inset-y-0 left-0 w-16 bg-linear-to-r from-tan dark:from-dark to-transparent z-30 pointer-events-none"></div>
    <div class="absolute inset-y-0 right-0 w-16 bg-linear-to-l from-tan dark:from-dark to-transparent z-30 pointer-events-none"></div>
    
    <!-- Track Container Slider Berjalan -->
    <div class="flex w-max items-center whitespace-nowrap animate-marquee">
      
      <!-- Set Pertama Ikon SVG -->
      <div class="flex shrink-0 items-center gap-16 pr-16">
        {techLogos.map((logo) => (
          <img src={logo.src} alt={logo.alt} height="32" decoding="async" class={logoClass(logo.invertDark)} />
        ))}
      </div>

      <!-- Set Kedua Duplikasi Ikon SVG (Wajib Sama Persis untuk Loop Mulus) -->
      <div class="flex shrink-0 items-center gap-16 pr-16" aria-hidden="true">
        {techLogos.map((logo) => (
          <img src={logo.src} alt="" height="32" decoding="async" loading="lazy" class={logoClass(logo.invertDark)} />
        ))}
      </div>

    </div>
  </div>

</section>

<!-- 4. GAYA ANIMASI RUNNING TEXT (Scoped CSS) -->
<style>
  /* keyframe milik ribbon techstack. Dua set identik dengan pr-16 di tiap set,
     sehingga pergeseran -50% tepat sebesar satu set */
  @keyframes marquee {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-50%, 0, 0); }
  }
  .animate-marquee {
    animation: marquee 25s linear infinite;
    will-change: transform;
  }
  /* Menghentikan jalan teks saat di-hover kursor */
  .animate-marquee:hover {
    animation-play-state: paused;
  }

  /* keyframe milik running text info */
  @keyframes marquee-text {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }
  .animate-marquee-text {
    animation: marquee-text 30s linear infinite;
    will-change: transform;
  }
  .animate-marquee-text:hover {
    animation-play-state: paused;
  }

  /* Hormati preferensi pengguna yang meminta gerakan dikurangi */
  @media (prefers-reduced-motion: reduce) {
    .animate-marquee,
    .animate-marquee-text {
      animation: none;
    }
  }
</style>

<!-- 5. ANIMASI CANVAS PIPELINE (Responsive & Adaptif Skema Tema) -->
<script>
  import { createThemeWatcher, createCanvasLoop } from '../../../scripts/canvas-utils';

  /* Teardown instance sebelumnya agar tidak ada loop ganda saat transisi halaman */
  let teardown: (() => void) | null = null;

  function initPipeline() {
    const canvas = document.getElementById('pipeline-canvas') as HTMLCanvasElement | null;
    if (!canvas || canvas.dataset.running === 'true') return;

    const context = canvas.getContext('2d');
    if (!context) return;
    const ctx: CanvasRenderingContext2D = context;

    teardown?.();
    canvas.dataset.running = 'true';

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    const spacing = 40;
    const speed = 1.5;
    
    // Warna Pipa adaptif dual-tema
    const colors = ['#0891b2', '#7c3aed', '#4f46e5', '#059669']; 
    
    class Pipe {
      x: number;
      y: number;
      dir: number;
      color: string;

      constructor() {
        this.x = Math.floor(Math.random() * (width / spacing)) * spacing;
        this.y = Math.floor(Math.random() * (height / spacing)) * spacing;
        this.dir = Math.floor(Math.random() * 4);
        this.color = colors[Math.floor(Math.random() * colors.length)];
      }

      update() {
        if (this.dir === 0) this.y -= speed;
        else if (this.dir === 1) this.x += speed;
        else if (this.dir === 2) this.y += speed;
        else if (this.dir === 3) this.x -= speed;

        if (Math.floor(this.x) % spacing === 0 && Math.floor(this.y) % spacing === 0) {
          if (Math.random() < 0.25) {
            const currentDir = this.dir;
            while (this.dir === currentDir || Math.abs(this.dir - currentDir) === 2) {
              this.dir = Math.floor(Math.random() * 4);
            }
          }
        }

        if (this.x < -100 || this.x > width + 100 || this.y < -100 || this.y > height + 100) {
          this.x = Math.floor(Math.random() * (width / spacing)) * spacing;
          this.y = Math.floor(Math.random() * (height / spacing)) * spacing;
          this.dir = Math.floor(Math.random() * 4);
        }
      }

      draw() {
        ctx.fillStyle = this.color;
        ctx.beginPath();
        ctx.arc(this.x, this.y, 1.2, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    const maxPipes = 20;
    const pipes: Pipe[] = Array.from({ length: maxPipes }, () => new Pipe());

    const theme = createThemeWatcher();

    const frame = () => {
      // Jika dark gunakan variabel --color-dark (#1a1a1a), jika light gunakan --color-tan (#edeadf) dengan alpha transparan
      ctx.fillStyle = theme.isDark() ? 'rgba(26, 26, 26, 0.05)' : 'rgba(237, 234, 223, 0.05)';
      ctx.fillRect(0, 0, width, height);

      for (const pipe of pipes) {
        pipe.update();
        pipe.draw();
      }
    };

    const loop = createCanvasLoop(canvas.closest('section'), frame);

    const onResize = () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    };
    window.addEventListener('resize', onResize, { passive: true });

    teardown = () => {
      loop.dispose();
      theme.dispose();
      window.removeEventListener('resize', onResize);
      canvas.dataset.running = '';
    };

    loop.start();
  }

  // Integrasi mulus untuk transisi halaman Astro View Transitions
  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = null;
  });
  document.addEventListener('astro:page-load', initPipeline);
  initPipeline();
</script>
